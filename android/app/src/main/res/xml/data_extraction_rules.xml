<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nada sai do aparelho em backup ou transferência. A chave do banco é presa ao
     Keystore deste aparelho; um banco restaurado em outro não abriria. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
